{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SiteConfig — Transportes Libertadores",
  "type": "object",
  "required": ["site", "theme", "sections"],
  "properties": {
    "site": {
      "type": "object",
      "required": ["brand"],
      "properties": {
        "brand": {
          "type": "object",
          "required": ["name", "shortName"],
          "properties": {
            "name": { "type": "string" },
            "shortName": { "type": "string" },
            "tagline": { "type": "string" },
            "description": { "type": "string" }
          }
        },
        "seo": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "description": { "type": "string" },
            "themeColor": { "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" }
          }
        },
        "contact": {
          "type": "object",
          "properties": {
            "locality": { "type": "string" },
            "localityNote": { "type": "string" },
            "phone": { "type": "string" },
            "phoneDisplay": { "type": "string" },
            "email": { "type": "string" },
            "whatsapp": { "type": "string" },
            "whatsappDisplay": { "type": "string" },
            "whatsappMessage": { "type": "string" },
            "facebookUrl": { "type": "string" },
            "facebookHandle": { "type": "string" },
            "mapQuery": { "type": "string" },
            "mapConfirmed": { "type": "boolean" }
          }
        }
      }
    },
    "theme": {
      "type": "object",
      "required": ["preset", "palette"],
      "properties": {
        "preset": { "enum": ["minimal"] },
        "palette": { "enum": ["custom"] },
        "colors": {
          "type": "object",
          "required": ["ink", "muted", "surface", "surfaceAlt", "brand", "brandDark", "accent"],
          "properties": {
            "ink": { "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" },
            "muted": { "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" },
            "surface": { "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" },
            "surfaceAlt": { "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" },
            "brand": { "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" },
            "brandDark": { "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" },
            "accent": { "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" }
          }
        },
        "typography": { "enum": ["libron-editorial"] },
        "radius": { "enum": ["sm", "md", "xl", "2xl", "full"] }
      }
    },
    "layout": {
      "type": "object",
      "properties": {
        "container": { "enum": ["sm", "md", "lg", "xl", "7xl"] },
        "sectionSpacing": { "enum": ["compact", "default"] }
      }
    },
    "navigation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "href"],
        "properties": {
          "label": { "type": "string" },
          "href": { "type": "string" },
          "section": {
            "enum": ["header", "hero", "destinations", "services", "agencies", "company", "faq", "contact", "footer"]
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "enabled"],
        "properties": {
          "id": {
            "enum": ["header", "hero", "destinations", "services", "agencies", "company", "faq", "contact", "footer"]
          },
          "enabled": { "type": "boolean" },
          "order": { "type": "number" },
          "variant": { "type": "string" },
          "props": { "type": "object" }
        }
      }
    },
    "order": {
      "type": "object",
      "properties": {
        "enabled": { "const": false },
        "units": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
